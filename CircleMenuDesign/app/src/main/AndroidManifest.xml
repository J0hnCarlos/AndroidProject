<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tutorialsee.circlemenu">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".CircleMenuActivity"
            android:label="@string/app_name" />
        <activity
            android:name=".CircleActivity"
            android:label="@string/app_name" />
        <activity
            android:name=".MainCircleActivity"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ResultActivity"
            android:label="@string/title_activity_result" />
        <activity
            android:name=".Result2Activity"
            android:label="@string/title_activity_result2"></activity>
    </application>

</manifest>